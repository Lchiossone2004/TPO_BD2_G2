{
  "name": "FarmaRed BD2 (MongoDB + Redis)",
  "dockerComposeFile": [
    "../docker-compose.yml",
    "docker-compose.devcontainer.yml"
  ],
  "service": "devcontainer",
  "workspaceFolder": "/workspace",
  "forwardPorts": [
    8000,
    27017,
    6379
  ],
  "portsAttributes": {
    "8000": {
      "label": "FarmaRed Web & API (FastAPI)",
      "onAutoForward": "notify"
    },
    "27017": {
      "label": "MongoDB (Replica Set rs0)"
    },
    "6379": {
      "label": "Redis Cache"
    }
  },
  "remoteEnv": {
    "MONGODB_URI": "mongodb://mongodb:27017/?replicaSet=rs0&directConnection=true",
    "MONGODB_DB": "farmared",
    "REDIS_URL": "redis://redis:6379/0"
  },
  "postCreateCommand": "pip install --no-cache-dir -r requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
