# Configuración de entorno para FarmaRed S.A. (TPO BD2)
# Copiar este archivo como `.env` para ejecución local desde el host.

# URI de MongoDB (Replica Set rs0 requerido para transacciones ACID multi-documento)
# - Desde el host local (puerto mapeado en docker-compose.yml):
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
# - Desde el devcontainer / GitHub Codespaces / red interna Docker:
# MONGODB_URI=mongodb://mongodb:27017/?replicaSet=rs0&directConnection=true

# Nombre de la base de datos en MongoDB
MONGODB_DB=farmared

# URL de conexión a Redis (caché cache-aside de productos y proveedores)
# - Desde el host local:
REDIS_URL=redis://localhost:6379/0
# - Desde el devcontainer / GitHub Codespaces / red interna Docker:
# REDIS_URL=redis://redis:6379/0
